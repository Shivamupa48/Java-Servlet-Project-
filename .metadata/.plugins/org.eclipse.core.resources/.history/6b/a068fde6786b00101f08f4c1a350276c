body {
    font-family: Arial, sans-serif;
    background: #f3f3f3;
    text-align: center;
    padding: 50px;
}

form {
    background: #fff;
    padding: 20px;
    display: inline-block;
    border-radius: 8px;
    box-shadow: 0 0 10px #aaa;
}

input, select, button {
    margin: 10px;
    padding: 10px;
    width: 200px;
    font-size: 16px;
}

button {
    background-color: #4CAF50;
    color: white;
    border: none;
    cursor: pointer;
}

button:hover {
    background-color: #45a049;
}
